{
  "name": "Join",
  "params": {
    "type": "outer",
    "withDS": [
      {
        "dsName": "performance.csv",
        "dsInfo": {
          "dsID": "DS1",
          "alias": "DS1",
          "iInfo": {
            "data": {
              "path": "file://resources/performance.csv",
              "options": { "header": "true" }
            }
          },
          "iType": "source"
        }
      }
    ],
    "keys": [
      {
        "cols": ["DS.campaign_id", "DS1.campaign_id"],
        "type": "equal",
        "iCase": false,
        "iSpace": false
      }
    ],
    "colList": [
      { "as": "campaign_id",   "cols": ["DS.campaign_id"] },
      { "as": "campaign_name", "cols": ["DS.campaign_name"] },
      { "as": "channel",       "cols": ["DS.channel"] },
      { "as": "budget",        "cols": ["DS.budget"] },
      { "as": "spend",         "cols": ["DS1.spend"] },
      { "as": "conversions",   "cols": ["DS1.conversions"] }
    ],
    "intCols": false
  }
}
