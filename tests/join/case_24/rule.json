{
  "name": "Join",
  "params": {
    "type": "left",
    "withDS": [
      {
        "dsName": "delays.csv",
        "dsInfo": {
          "dsID": "DS1",
          "alias": "DS1",
          "iInfo": {
            "data": {
              "path": "file://resources/delays.csv",
              "options": { "header": "true" }
            }
          },
          "iType": "source"
        }
      }
    ],
    "keys": [
      {
        "cols": ["DS.flight_id", "DS1.flight_id"],
        "type": "equal",
        "iCase": false,
        "iSpace": false
      }
    ],
    "colList": [
      { "as": "flight_id",      "cols": ["DS.flight_id"] },
      { "as": "origin",         "cols": ["DS.origin"] },
      { "as": "destination",    "cols": ["DS.destination"] },
      { "as": "airline",        "cols": ["DS.airline"] },
      { "as": "delay_minutes",  "cols": ["DS1.delay_minutes"] },
      { "as": "reason",         "cols": ["DS1.reason"] }
    ],
    "intCols": true
  }
}
