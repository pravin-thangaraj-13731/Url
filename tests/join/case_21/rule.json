{
  "name": "Join",
  "params": {
    "type": "inner",
    "withDS": [
      {
        "dsName": "returns.csv",
        "dsInfo": {
          "dsID": "DS1",
          "alias": "DS1",
          "iInfo": {
            "data": {
              "path": "file://resources/returns.csv",
              "options": { "header": "true" }
            }
          },
          "iType": "source"
        }
      }
    ],
    "keys": [
      {
        "cols": ["DS.order_id", "DS1.order_id"],
        "type": "equal",
        "iCase": false,
        "iSpace": false
      }
    ],
    "colList": [
      { "as": "order_id",      "cols": ["DS.order_id"] },
      { "as": "customer_id",   "cols": ["DS.customer_id"] },
      { "as": "status",        "cols": ["DS.status"] },
      { "as": "return_date",   "cols": ["DS1.return_date"] },
      { "as": "refund_amount", "cols": ["DS1.refund_amount"] }
    ],
    "intCols": true
  }
}
