{
  "name": "Join",
  "params": {
    "type": "outer",
    "withDS": [
      {
        "dsName": "inventory.csv",
        "dsInfo": {
          "dsID": "DS1",
          "alias": "DS1",
          "iInfo": {
            "data": {
              "path": "file://resources/inventory.csv",
              "options": { "header": "true" }
            }
          },
          "iType": "source"
        }
      }
    ],
    "keys": [
      {
        "cols": ["DS.isbn", "DS1.isbn"],
        "type": "equal",
        "iCase": false,
        "iSpace": false
      }
    ],
    "colList": [
      { "as": "isbn",               "cols": ["DS.isbn"] },
      { "as": "title",              "cols": ["DS.title"] },
      { "as": "genre",              "cols": ["DS.genre"] },
      { "as": "copies_available",   "cols": ["DS1.copies_available"] },
      { "as": "shelf_location",     "cols": ["DS1.shelf_location"] }
    ],
    "intCols": false
  }
}
