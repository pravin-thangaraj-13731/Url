{
  "name": "Join",
  "params": {
    "type": "leftexclude",
    "withDS": [
      {
        "dsName": "discounts.csv",
        "dsInfo": {
          "dsID": "DS1",
          "alias": "DS1",
          "iInfo": {
            "data": {
              "path": "file://resources/discounts.csv",
              "options": { "header": "true" }
            }
          },
          "iType": "source"
        }
      }
    ],
    "keys": [
      {
        "cols": ["DS.product_code", "DS1.product_code"],
        "type": "equal",
        "iCase": false,
        "iSpace": false
      }
    ],
    "colList": [
      { "as": "product_code",  "cols": ["DS.product_code"] },
      { "as": "product_name",  "cols": ["DS.product_name"] },
      { "as": "category",      "cols": ["DS.category"] },
      { "as": "unit_price",    "cols": ["DS.unit_price"] }
    ],
    "intCols": false
  }
}
