{
  "name": "Join",
  "params": {
    "type": "inner",
    "withDS": [
      {
        "dsName": "accounts.csv",
        "dsInfo": {
          "dsID": "DS1",
          "alias": "DS1",
          "iInfo": {
            "data": {
              "path": "file://resources/accounts.csv",
              "options": { "header": "true" }
            }
          },
          "iType": "source"
        }
      }
    ],
    "keys": [
      {
        "cols": ["DS.account_id", "DS1.account_id"],
        "type": "equal",
        "iCase": false,
        "iSpace": false
      }
    ],
    "colList": [
      { "as": "txn_id",      "cols": ["DS.txn_id"] },
      { "as": "account_id",  "cols": ["DS.account_id"] },
      { "as": "txn_date",    "cols": ["DS.txn_date"] },
      { "as": "amount",      "cols": ["DS.amount"] },
      { "as": "owner",       "cols": ["DS1.owner"] },
      { "as": "status",      "cols": ["DS1.status"] }
    ],
    "intCols": false
  }
}
