{
  "name": "Join",
  "params": {
    "type": "outerexclude",
    "withDS": [
      {
        "dsName": "amendments.csv",
        "dsInfo": {
          "dsID": "DS1",
          "alias": "DS1",
          "iInfo": {
            "data": {
              "path": "file://resources/amendments.csv",
              "options": { "header": "true" }
            }
          },
          "iType": "source"
        }
      }
    ],
    "keys": [
      {
        "cols": ["DS.Contract_ID", "DS1.Contract_ID"],
        "type": "equal",
        "iCase": false,
        "iSpace": false
      }
    ],
    "colList": [
      { "as": "Contract_ID",     "cols": ["DS.Contract_ID"] },
      { "as": "client_name",     "cols": ["DS.client_name"] },
      { "as": "amendment_date",  "cols": ["DS1.amendment_date"] },
      { "as": "amendment_type",  "cols": ["DS1.amendment_type"] }
    ],
    "intCols": false
  }
}
