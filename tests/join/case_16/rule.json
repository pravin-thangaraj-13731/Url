{
  "name": "Join",
  "params": {
    "type": "rightexclude",
    "withDS": [
      {
        "dsName": "purchase_orders.csv",
        "dsInfo": {
          "dsID": "DS1",
          "alias": "DS1",
          "iInfo": {
            "data": {
              "path": "file://resources/purchase_orders.csv",
              "options": { "header": "true" }
            }
          },
          "iType": "source"
        }
      }
    ],
    "keys": [
      {
        "cols": ["DS.vendor_id", "DS1.vendor_id"],
        "type": "equal",
        "iCase": false,
        "iSpace": false
      }
    ],
    "colList": [
      { "as": "po_id",   "cols": ["DS1.po_id"] },
      { "as": "amount",  "cols": ["DS1.amount"] },
      { "as": "status",  "cols": ["DS1.status"] }
    ],
    "intCols": false
  }
}
