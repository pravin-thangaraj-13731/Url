{
  "name": "Join",
  "params": {
    "type": "rightexclude",
    "withDS": [
      {
        "dsName": "readings.csv",
        "dsInfo": {
          "dsID": "DS1",
          "alias": "DS1",
          "iInfo": {
            "data": {
              "path": "file://resources/readings.csv",
              "options": { "header": "true" }
            }
          },
          "iType": "source"
        }
      }
    ],
    "keys": [
      {
        "cols": ["DS.sensor_id", "DS1.sensor_id"],
        "type": "equal",
        "iCase": false,
        "iSpace": false
      }
    ],
    "colList": [
      { "as": "sensor_id",   "cols": ["DS1.sensor_id"] },
      { "as": "reading_ts",  "cols": ["DS1.reading_ts"] },
      { "as": "value",       "cols": ["DS1.value"] },
      { "as": "unit",        "cols": ["DS1.unit"] }
    ],
    "intCols": false
  }
}
