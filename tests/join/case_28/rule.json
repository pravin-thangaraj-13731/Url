{
  "name": "Join",
  "params": {
    "type": "inner",
    "withDS": [
      {
        "dsName": "permissions.csv",
        "dsInfo": {
          "dsID": "DS1",
          "alias": "DS1",
          "iInfo": {
            "data": {
              "path": "file://resources/permissions.csv",
              "options": { "header": "true" }
            }
          },
          "iType": "source"
        }
      }
    ],
    "keys": [
      {
        "cols": ["DS.username", "DS1.username"],
        "type": "equal",
        "iCase": true,
        "iSpace": true
      }
    ],
    "colList": [
      { "as": "user_id",  "cols": ["DS.user_id"] },
      { "as": "username", "cols": ["DS.username"] },
      { "as": "role",     "cols": ["DS.role"] },
      { "as": "resource", "cols": ["DS1.resource"] },
      { "as": "action",   "cols": ["DS1.action"] }
    ],
    "intCols": true
  }
}
