{
  "name": "Join",
  "params": {
    "type": "leftexclude",
    "withDS": [
      {
        "dsName": "trade_partners.csv",
        "dsInfo": {
          "dsID": "DS1",
          "alias": "DS1",
          "iInfo": {
            "data": {
              "path": "file://resources/trade_partners.csv",
              "options": { "header": "true" }
            }
          },
          "iType": "source"
        }
      }
    ],
    "keys": [
      {
        "cols": ["DS.country_code", "DS1.country_code"],
        "type": "equal",
        "iCase": false,
        "iSpace": false
      }
    ],
    "colList": [
      { "as": "country_code",  "cols": ["DS.country_code"] },
      { "as": "country_name",  "cols": ["DS.country_name"] },
      { "as": "continent",     "cols": ["DS.continent"] },
      { "as": "gdp_usd_bn",    "cols": ["DS.gdp_usd_bn"] }
    ],
    "intCols": false
  }
}
