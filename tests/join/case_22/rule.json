{
  "name": "Join",
  "params": {
    "type": "left",
    "withDS": [
      {
        "dsName": "reviews.csv",
        "dsInfo": {
          "dsID": "DS1",
          "alias": "DS1",
          "iInfo": {
            "data": {
              "path": "file://resources/reviews.csv",
              "options": { "header": "true" }
            }
          },
          "iType": "source"
        }
      }
    ],
    "keys": [
      {
        "cols": ["DS.employee_id", "DS1.employee_id"],
        "type": "equal",
        "iCase": false,
        "iSpace": false
      }
    ],
    "colList": [
      { "as": "employee_id", "cols": ["DS.employee_id"] },
      { "as": "name",        "cols": ["DS.name"] },
      { "as": "dept",        "cols": ["DS.dept"] },
      { "as": "salary",      "cols": ["DS.salary"] },
      { "as": "score",       "cols": ["DS1.score"] },
      { "as": "reviewer",    "cols": ["DS1.reviewer"] }
    ],
    "intCols": false
  }
}
